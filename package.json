{
  "name": "ai-tabs",
  "version": "0.35.1",
  "description": "Electron tab manager for AI coding-agent terminals (Claude Code, Codex, Gemini, ...)",
  "main": "main.js",
  "repository": "github:servosity/ai-tabs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "start-server": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "rebuild": "node scripts/patch-spectre.js && node scripts/brand-electron.js && electron-rebuild --force",
    "postinstall": "node scripts/patch-spectre.js && node scripts/brand-electron.js && electron-rebuild"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^41.10.6",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.0"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@tootallnate/once": "^3.0.0",
    "path-to-regexp": "^0.1.13",
    "brace-expansion": "^2.1.3",
    "picomatch": "^4.0.4",
    "qs": "^6.15.2"
  }
}
