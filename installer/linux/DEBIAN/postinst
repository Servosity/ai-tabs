#!/bin/bash
set -e

# ── Install npm dependencies ────────────────────────────────────────────────
echo "Installing ai-tabs dependencies..."
cd /opt/ai-tabs
npm install --no-fund --no-audit 2>/dev/null || npm install

# ── CLI symlink ─────────────────────────────────────────────────────────────
chmod +x /opt/ai-tabs/ai-tabs.sh
ln -sf /opt/ai-tabs/ai-tabs.sh /usr/local/bin/ai-tabs

# ── Desktop entry ───────────────────────────────────────────────────────────
cat > /usr/share/applications/ai-tabs.desktop << 'DESKTOP'
[Desktop Entry]
Name=ai-tabs
Comment=Browser-based tab manager for AI coding-agent terminals
Exec=/opt/ai-tabs/ai-tabs.sh
Terminal=false
Type=Application
Categories=Development;
StartupNotify=false
DESKTOP

# Update desktop database if available
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications 2>/dev/null || true
fi

echo "ai-tabs installed successfully."
echo "  Run 'ai-tabs' to launch."
