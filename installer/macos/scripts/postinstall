#!/bin/bash
# ai-tabs macOS .pkg post-install script
# Runs npm install, creates .app bundle and CLI symlink

set -e

INSTALL_DIR="${HOME}/.local/share/ai-tabs"

# ── npm install ──────────────────────────────────────────────────────────────
cd "$INSTALL_DIR"
npm install --no-fund --no-audit 2>/dev/null || npm install

# ── Make launcher executable ─────────────────────────────────────────────────
chmod +x "${INSTALL_DIR}/ai-tabs.sh"

# ── CLI symlink ──────────────────────────────────────────────────────────────
mkdir -p "${HOME}/.local/bin"
ln -sf "${INSTALL_DIR}/ai-tabs.sh" "${HOME}/.local/bin/ai-tabs"

# ── .app bundle ──────────────────────────────────────────────────────────────
APP_DIR="${HOME}/Applications/ai-tabs.app"
mkdir -p "${APP_DIR}/Contents/MacOS"
mkdir -p "${APP_DIR}/Contents/Resources"

cat > "${APP_DIR}/Contents/Info.plist" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ai-tabs</string>
    <key>CFBundleDisplayName</key>
    <string>ai-tabs</string>
    <key>CFBundleIdentifier</key>
    <string>com.servosity.ai-tabs</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleExecutable</key>
    <string>ai-tabs</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
</dict>
</plist>
PLIST

# Apps launched from Finder/Spotlight get a minimal PATH (no Homebrew, no
# ~/.local/bin), so bake in the Node found now and add the usual agent CLI
# locations. Fall back to Homebrew's prefix if node isn't on this script's PATH.
NODE_DIR="$(dirname "$(command -v node 2>/dev/null || echo /opt/homebrew/bin/node)")"
cat > "${APP_DIR}/Contents/MacOS/ai-tabs" << LAUNCHER
#!/bin/bash
export PATH="${NODE_DIR}:/opt/homebrew/bin:/usr/local/bin:\$HOME/.local/bin:\$PATH"
ELECTRON_APP="${INSTALL_DIR}/node_modules/electron/dist/Electron.app"

# Already running? Bring the existing window forward instead of opening another.
if pgrep -f "\$ELECTRON_APP/Contents/MacOS/Electron \\." >/dev/null; then
    exec open -a "\$ELECTRON_APP"
fi

cd "${INSTALL_DIR}"
exec node scripts/start.js
LAUNCHER
chmod +x "${APP_DIR}/Contents/MacOS/ai-tabs"

exit 0
